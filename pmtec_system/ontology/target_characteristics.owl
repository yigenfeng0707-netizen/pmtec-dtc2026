<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://pmtec.example.org/tc#"
         xmlns="http://pmtec.example.org/tc#">

<owl:Ontology rdf:about="http://pmtec.example.org/tc.owl"/>

<owl:ObjectProperty rdf:about="http://pmtec.example.org/tc#hasAccessState">
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://pmtec.example.org/tc#AccessState"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://pmtec.example.org/tc#hasPart">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://pmtec.example.org/tc#FacilityPart"/>
  <owl:inverseOf rdf:resource="http://pmtec.example.org/tc#partOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://pmtec.example.org/tc#partOf">
  <owl:inverseOf rdf:resource="http://pmtec.example.org/tc#hasPart"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#observableProperty"/>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#runwayLengthM">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#Runway"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#personnelCount">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#areaAcres">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#latitude">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#longitude">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#tierLevel">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#branchCode">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#accessUncertainty">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#countryName">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#regionName">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#basedAircraft">
  <rdfs:subPropertyOf rdf:resource="http://pmtec.example.org/tc#observableProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://pmtec.example.org/tc#singleRunwayDependency">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="http://pmtec.example.org/tc#MilitaryInstallation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#AirBase">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://pmtec.example.org/tc#hasPart"/>
      <owl:someValuesFrom rdf:resource="http://pmtec.example.org/tc#Runway"/>
    </owl:Restriction>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#NavalBase">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#LandBase">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#SupportSite">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#FacilityPart">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#Runway">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://pmtec.example.org/tc#partOf"/>
      <owl:someValuesFrom rdf:resource="http://pmtec.example.org/tc#MilitaryInstallation"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#Hangar">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#FacilityPart"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#FuelDepot">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#FacilityPart"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#RadarSite">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#FacilityPart"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#DefensePosition">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#FacilityPart"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#Aircraft">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#AccessState">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#OpenState">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#AccessState"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#RestrictedState">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#AccessState"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#DeniedState">
  <rdfs:subClassOf rdf:resource="http://pmtec.example.org/tc#AccessState"/>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#LaunchCapable">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://pmtec.example.org/tc#hasAccessState"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://pmtec.example.org/tc#OpenState"/>
            <rdf:Description rdf:about="http://pmtec.example.org/tc#RestrictedState"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="http://pmtec.example.org/tc#AccessDeniedSite">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:complementOf rdf:resource="http://pmtec.example.org/tc#LaunchCapable"/>
    </owl:Class>
  </rdfs:subClassOf>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://pmtec.example.org/tc#hasAccessState"/>
      <owl:hasValue rdf:resource="http://pmtec.example.org/tc#state_denied"/>
    </owl:Restriction>
  </owl:equivalentClass>
</owl:Class>

<owl:NamedIndividual rdf:about="http://pmtec.example.org/tc#state_open">
  <rdf:type rdf:resource="http://pmtec.example.org/tc#OpenState"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://pmtec.example.org/tc#state_restricted">
  <rdf:type rdf:resource="http://pmtec.example.org/tc#RestrictedState"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://pmtec.example.org/tc#state_denied">
  <rdf:type rdf:resource="http://pmtec.example.org/tc#DeniedState"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://pmtec.example.org/tc#base_JP_MISAWA">
