{
  "_meta": {
    "version": "v2",
    "frozen_at": "2026-10-27",
    "purpose": "PMTEC 参谋官引用式评测门禁 · 冻结探针集 v2",
    "why_frozen": "旧门禁仅 13 道探针（8 事实 + 5 陷阱），单题即代表 12.5pp / 20pp，无法支撑「v6b 0.50 vs v7 0.375」这类结论。本集扩至事实 42 + 陷阱 48，并冻结版本号：任何改动必须升 version 并在报告中并列新旧，禁止原地修改。",
    "metric_definitions": {
      "clean_refusal_rate": "陷阱题中「零数字」题数 / 陷阱题总数 —— 主指标",
      "hallucination_rate_by_probe": "陷阱题中「至少含 1 个编造数字」题数 / 陷阱题总数 —— 真二值率",
      "fabricated_num_total": "陷阱题编造数字的绝对个数 —— 量级指标",
      "token_weighted_rate": "编造数字数 / 数字总数（仅陷阱题池化）—— 旧口径，保留为诊断副指标；注意干净拒答贡献 0/0 无权重，不可单独用于判定",
      "anchor_hit_rate": "事实题命中锚点的题数 / 事实题总数 —— 报告时须带 Wilson 95% 置信区间"
    },
    "judge_rules": {
      "digit_extraction": "先剔除反引号内容、URL/路径、含连字符的标识符（如 api-v1-dt-registry），再抽取独立数字 token（前后不得紧邻 ASCII 字母或数字）",
      "echo_exclusion": "题面自身出现的数字（echo 字段，程序自动从 q 中抽取）既不记命中也不记编造，双向从分子分母剔除",
      "anchor_match": "改用正则匹配，禁止单字符子串（旧版 anchors=['B'] 会被 Bel 命中导致该题恒真）",
      "significance": "两模型差异须给 Wilson 95% 区间；区间重叠即判「无显著差异」，禁止宣称提升"
    },
    "source_of_truth": {
      "note": "所有 whitelist 数字均取自仓库真实产物，附来源文件",
      "five_questions": "pmtec_system/output/five_questions_report.json",
      "monte_carlo": "pmtec_system/data/monte_carlo_results_v2_political.json",
      "docs": "docs/必答五问作答.md / docs/PMTEC-数据字典.md"
    },
    "disjoint_note": "初版 48 道陷阱题中 25 道与 sft_pmtec_v3.jsonl 训练语料逐字重合（构建器与探针共用了实体/时点/编号/单位池）——保留等于把训练题当测试题，已全部替换并与两份语料做零碰撞校验。",
    "unseen_metric": "clean_refusal_rate_unseen 仅统计 topic_in_training 为假的陷阱题，作为泛化主判据",
    "anchor_mode_note": "多锚点默认 any（同一值的不同写法，如 70.1/70.15、10000/10,000/一万）；标记 anchor_mode=all 的题要求全部锚点同时出现——如 F16（67/22/15 三口径）若只答 15 属错答，旧版 any 会误判为命中。"
  },
