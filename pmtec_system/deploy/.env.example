# PMTEC 环境配置模板
# 复制为 .env 并修改:  cp .env.example .env

# ---- GitHub 仓库 ----
# 私有仓库访问令牌 (个人访问令牌, 需 repo 权限)
GITHUB_TOKEN=

# ---- gRPC 服务 ----
GRPC_HOST=0.0.0.0
# 各服务端口: WarEngine=50051 BattleNetwork=50052 ApplicationStore=50053 PlugAndPlay=50054

# ---- 安全 ----
SECURITY_ENABLED=0
MTLS_ENABLED=0
JWT_SECRET=change-me-in-production

# ---- 实时数据 API ----
# 开启后服务会调用真实 API (需公网访问)
LIVE_DATA_USE_REAL_API=0

# ---- 分布式追踪 ----
PMTEC_TRACING=1
PMTEC_TRACING_ENDPOINT=jaeger:4317

# ---- Prometheus ----
PROMETHEUS_ENABLED=1
PROMETHEUS_PORT=9090

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=admin

# ---- 资源限制 ----
# 低配 ECS (2C4G) 建议限制内存
MEM_LIMIT_WAR_ENGINE=512m
MEM_LIMIT_BATTLE_NETWORK=256m
MEM_LIMIT_APP_STORE=512m
MEM_LIMIT_PLUG_PLAY=256m
